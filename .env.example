# Copy this file to .env and fill in as needed.
# Defaults below work out of the box with docker-compose for local dev.

# --- Database ---
# Local dev (docker-compose):
DATABASE_URL=postgresql://stockali:stockali_dev_password@db:5432/stockali
# Supabase (replace with your project's connection string when ready):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRY_MINUTES=1440

# --- Object storage (fill in once Supabase Storage or R2 is set up) ---
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- App ---
ENVIRONMENT=development
